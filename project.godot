; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="souls"
config/version="0.3.0"
run/main_scene="res://scenes/expedition/boss_court.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RetroFX="*res://scenes/fx/retro_fx.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=false

[input]

move_left={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_forward={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
look_left={
"deadzone": 0.22,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.22,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.22,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.22,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
lock_on={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":3), Object(InputEventJoypadButton,"device":-1,"button_index":8)]
}
release_cursor={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
light_attack={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadButton,"device":-1,"button_index":10)]
}
heavy_attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
heavy_trigger={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
block={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventJoypadButton,"device":-1,"button_index":9)]
}
parry={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
parry_trigger={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
roll={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
restart_duel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
combat_debug={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
interact={
